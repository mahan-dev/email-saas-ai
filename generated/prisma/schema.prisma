generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  emailAddress String    @unique
  firstName    String
  lastName     String
  imageUrl     String?
  accounts     Account[]
}

model Account {
  id           String @id @default(cuid())
  userId       String
  token        String @unique
  emailAddress String
  name         String

  user User @relation(fields: [userId], references: [id])
}
